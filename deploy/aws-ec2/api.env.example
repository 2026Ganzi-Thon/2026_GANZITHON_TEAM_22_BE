# Copy to .env.api and set one unquoted value per line.
GANZI_DB_URL=jdbc:mysql://replace-with-rds-endpoint:3306/haeboyang?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/haeboyang/rds-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&fallbackToSystemTrustStore=false
GANZI_DB_USERNAME=haeboyang
GANZI_DB_PASSWORD=
# Team QA web origins. For a public-only release, keep only its deployed browser origins.
GANZI_ALLOWED_ORIGINS=https://haeboyang.anhs-0218.workers.dev,http://localhost:8081
# Keep false for cost-free QA. For an AI-enabled release, follow the activation steps in README.md.
GANZI_CHAT_ENABLED=false
GANZI_CHAT_BUDGET_SCOPE=staging
GANZI_CHAT_DAILY_USD=0.25
GANZI_CHAT_MONTHLY_USD=0.25
GANZI_CHAT_USER_DAILY_REQUESTS=30
OPENAI_API_KEY=
GANZI_OPENAI_MODEL=gpt-6.2-sol
GANZI_OPENAI_REASONING_EFFORT=medium
GANZI_PUSH_ENABLED=false
